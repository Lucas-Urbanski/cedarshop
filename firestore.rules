rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return signedIn()
        && userDocExists()
        && (
          userRole() == role
          || (role == 'administrator' && userRole() == 'Administrator')
          || (role == 'floorstaff' && userRole() == 'FloorStaff')
          || (role == 'salesstaff' && userRole() == 'SalesStaff')
          || (role == 'driver' && userRole() == 'Driver')
          || (role == 'customer' && userRole() == 'Customer')
        );
    }

    function isAdmin() {
      return hasRole('administrator');
    }

    function isFloorStaff() {
      return hasRole('floorstaff');
    }

    function isSalesStaff() {
      return hasRole('salesstaff');
    }

    function isDriver() {
      return hasRole('driver');
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isYardStaff() {
      return isAdmin() || isFloorStaff();
    }

    function isStaffOrAdmin() {
      return isAdmin() || isSalesStaff() || isFloorStaff() || isDriver();
    }

    match /users/{userId} {
      // Allow signed-in user to read their own profile even if email_verified hasn't refreshed yet,
      // preventing false "user not found" states right after sign-up.
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'role',
          'createdAt',
          'shippingAddress'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'role',
          'createdAt',
          'shippingAddress',
          'phone',
          'company'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.role == 'customer'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.shippingAddress is map
        && request.resource.data.shippingAddress.keys().hasAll([
          'street',
          'city',
          'postalCode'
        ])
        && request.resource.data.shippingAddress.keys().hasOnly([
          'street',
          'city',
          'postalCode',
          'province'
        ])
        && request.resource.data.shippingAddress.street is string
        && request.resource.data.shippingAddress.city is string
        && request.resource.data.shippingAddress.postalCode is string
        && (!request.resource.data.shippingAddress.keys().hasAny(['province'])
          || request.resource.data.shippingAddress.province is string)
        && (!request.resource.data.keys().hasAny(['phone'])
          || request.resource.data.phone is string)
        && (!request.resource.data.keys().hasAny(['company'])
          || request.resource.data.company is string);

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName',
            'phone',
            'company',
            'shippingAddress'
          ])
          && request.resource.data.fullName is string
          && request.resource.data.phone is string
          && request.resource.data.company is string
          && request.resource.data.shippingAddress is map
          && request.resource.data.shippingAddress.keys().hasAll([
            'street',
            'city',
            'postalCode',
            'province'
          ])
          && request.resource.data.shippingAddress.keys().hasOnly([
            'street',
            'city',
            'postalCode',
            'province'
          ])
          && request.resource.data.shippingAddress.street is string
          && request.resource.data.shippingAddress.city is string
          && request.resource.data.shippingAddress.postalCode is string
          && request.resource.data.shippingAddress.province is string);

      allow delete: if isAdmin();
    }

    match /products/{sku} {
      allow read: if true;
      allow create: if (isAdmin()
          || (isFloorStaff()
            && request.resource.data.keys().hasOnly(['name', 'price'])))
        && request.resource.data.keys().hasAll(['name', 'price'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow update: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'price'])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow delete: if isAdmin();
    }

    match /inventory/{sku} {
      allow read: if isYardStaff() || isSalesStaff();
      allow create: if isYardStaff()
        && request.resource.data.keys().hasAll([
          'name',
          'dimensions',
          'location',
          'bay',
          'quantity',
          'minimum'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && (isAdmin()
          || (request.resource.data.keys().hasOnly([
              'name',
              'dimensions',
              'location',
              'bay',
              'quantity',
              'minimum',
              'moisturePercent',
              'dryWeightLbs',
              'isGreenStock',
              'weightPerUnitLbs'
            ])
            && existsAfter(
              /databases/$(database)/documents/products/$(sku)
            )
            && getAfter(
              /databases/$(database)/documents/products/$(sku)
            ).data.name == request.resource.data.name
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.dimensions is string
            && request.resource.data.dimensions.size() > 0
            && request.resource.data.dimensions.size() <= 80
            && request.resource.data.location in [
              'Outdoor yard',
              'Warehouse',
              'Kiln'
            ]
            && request.resource.data.bay is string
            && request.resource.data.bay.size() > 0
            && request.resource.data.bay.size() <= 24
            && request.resource.data.quantity > 0
            && request.resource.data.quantity <= 1000000
            && request.resource.data.minimum is int
            && request.resource.data.minimum >= 0
            && request.resource.data.minimum <= 1000000));
      allow update: if isAdmin()
        || (isFloorStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'quantity',
            'bay',
            'location',
            'moisturePercent',
            'dryWeightLbs',
            'isGreenStock',
            'weightPerUnitLbs'
          ])
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0
          && request.resource.data.bay is string
          && request.resource.data.location in [
            'Outdoor yard',
            'Warehouse',
            'Kiln'
          ]);
      allow delete: if isAdmin();
    }

    match /productCosts/{sku} {
      allow read, write: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin() || isSalesStaff() || isFloorStaff();
      allow create, update, delete: if isAdmin();
    }

    match /yardWorkOrders/{workOrderId} {
      allow read: if isYardStaff();
      allow create: if isYardStaff()
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.status == 'Queued'
          || (isAdmin() && request.resource.data.status in [
            'In progress',
            'Completed'
          ]))
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;
      allow update: if isAdmin()
        || (isFloorStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
          && request.resource.data.status in [
            'Queued',
            'In progress',
            'Completed'
          ]);
      allow delete: if isAdmin();
    }

    match /yardLossReports/{reportId} {
      allow read: if isYardStaff() || isSalesStaff();
      allow create: if isYardStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'Pending review'
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.notes is string
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 400000
        && (!request.resource.data.keys().hasAny(['tagType'])
          || request.resource.data.tagType in ['Damaged', 'Lost'])
        && (!request.resource.data.keys().hasAny(['reason'])
          || request.resource.data.reason is string)
        && (!request.resource.data.keys().hasAny(['sku'])
          || request.resource.data.sku is string);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedBy',
          'reviewedAt'
        ])
        && request.resource.data.status in ['Approved', 'Rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /yardActivity/{activityId} {
      allow read: if isYardStaff();
      allow create: if isYardStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.at is string;
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || isSalesStaff()
        || (isCustomer() && resource.data.customerUid == request.auth.uid);
      allow create: if (isCustomer() && request.resource.data.customerUid == request.auth.uid)
        || isSalesStaff()
        || isAdmin();
      allow update: if isAdmin()
        || isSalesStaff()
        || (isCustomer()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items',
            'quantity',
            'unit',
            'status'
          ])
          && request.resource.data.items is string
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.total == resource.data.total
          && request.resource.data.status in ['Pending', 'Cancelled']);
      allow delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow get, list: if isAdmin()
        || isSalesStaff()
        || (isCustomer() && resource.data.customerUid == request.auth.uid)
        || (isDriver()
          && (resource.data.driverUid == request.auth.uid
            || resource.data.isDemo == true));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isDriver()
          && (resource.data.driverUid == request.auth.uid
            || resource.data.isDemo == true)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'deliveredAt',
            'photoUrl',
            'lastLocation'
          ])
          && request.resource.data.status in [
            'Ready',
            'In Progress',
            'Delivered'
          ]);
    }

    match /salesQuotes/{quoteId} {
      allow read: if isAdmin()
        || (isSalesStaff() && resource.data.createdBy == request.auth.uid);
      allow create: if isSalesStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.items is list
        && request.resource.data.subtotal is number
        && request.resource.data.discountPercent is number
        && request.resource.data.discountPercent >= 0
        && request.resource.data.discountPercent <= 100
        && request.resource.data.total is number;
      allow update, delete: if isAdmin();
    }

    match /system/{documentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}